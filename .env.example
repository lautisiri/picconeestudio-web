# Piccone Estudio — variables de entorno
#
# En producción (Netlify), las Netlify Blobs funcionan automáticamente sin
# configuración adicional: Netlify inyecta el contexto necesario en cada
# función/ruta. Estas variables solo son necesarias si querés probar el
# almacenamiento de consultas fuera de Netlify (por ejemplo con `netlify dev`
# apuntando a un site remoto), o para integraciones futuras.

# URL pública del sitio (usada en metadatos SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://piccone.com.uy

# Número de WhatsApp del estudio en formato internacional sin espacios ni signos
NEXT_PUBLIC_WHATSAPP_NUMBER=59892723916

# Opcional: solo necesario para desarrollo local avanzado con `netlify dev`
# conectado a un site real de Netlify (no requerido para `npm run dev`).
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
